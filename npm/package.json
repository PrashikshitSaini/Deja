{
  "name": "deja",
  "version": "0.3.0",
  "description": "Your shell remembers every command. Deja helps you find the right one. A fast, local-only Zsh command palette.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrashikshitSaini/Deja.git"
  },
  "homepage": "https://github.com/PrashikshitSaini/Deja#readme",
  "bugs": "https://github.com/PrashikshitSaini/Deja/issues",
  "keywords": [
    "zsh",
    "shell",
    "history",
    "command-palette",
